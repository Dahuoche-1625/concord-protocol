{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-protocol.dev/schemas/execution_receipt.json",
  "title": "ExecutionReceipt",
  "type": "object",
  "additionalProperties": true,
  "required": ["receipt_id", "task_id", "lease_id", "agent_id", "node_id", "status", "artifact_refs", "guard_result", "execution_hash", "generated_at", "source_refs"],
  "properties": {
    "receipt_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "lease_id": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string", "minLength": 1 },
    "node_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["done", "partial_done", "failed", "invalid"] },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_id", "uri", "sha256", "size_bytes", "created_at"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "type": { "type": "string" },
          "uri": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 1 },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "log_refs": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array" },
    "errors": { "type": "array" },
    "guard_result": {
      "type": "object",
      "required": ["mode", "status", "blocking_violations"],
      "properties": {
        "mode": { "enum": ["verify_only", "guarded_verify"] },
        "status": { "enum": ["pass", "fail"] },
        "blocking_violations": { "type": "array" },
        "warnings": { "type": "array" }
      }
    },
    "execution_hash": {
      "type": "object",
      "required": ["method", "artifact_refs_hash", "receipt_hash"],
      "properties": {
        "method": { "const": "sha256" },
        "artifact_refs_hash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "receipt_hash": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
      }
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
