{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concord-protocol.dev/schemas/approval_grant_v0.1",
  "title": "ApprovalGrant v0.1",
  "description": "Owner-signed snapshot. Runtime verifies without reading Project facts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "approval_id", "action", "artifact_sha256", "channel_id",
    "max_privacy", "granted_by", "granted_at", "expires_at",
    "revoked", "source_proof"
  ],
  "properties": {
    "approval_id": { "type": "string", "pattern": "^[a-f0-9-]{36}$" },
    "action": { "const": "upload" },
    "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "channel_id": { "type": "string", "pattern": "^UC[A-Za-z0-9_-]{22}$" },
    "max_privacy": {
      "enum": ["private", "unlisted", "public"]
    },
    "granted_by": { "type": "string", "minLength": 1 },
    "granted_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "revoked": { "type": "boolean", "default": false },
    "revoked_at": { "type": "string", "format": "date-time" },
    "conditions": { "type": "string" },
    "source_proof": {
      "$ref": "#/$defs/proof",
      "description": "Signature over all required fields"
    }
  },
  "$defs": {
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "key_ref", "signed_fields", "value"],
      "properties": {
        "method": { "enum": ["hmac", "signature"] },
        "key_ref": { "type": "string", "pattern": "^secret://[A-Za-z0-9_-]+$" },
        "signed_fields": {
          "type": "array",
          "minItems": 7,
          "uniqueItems": true,
          "contains": { "const": "approval_id" },
          "allOf": [
            { "contains": { "const": "action" } },
            { "contains": { "const": "artifact_sha256" } },
            { "contains": { "const": "channel_id" } },
            { "contains": { "const": "max_privacy" } },
            { "contains": { "const": "expires_at" } },
            { "contains": { "const": "revoked" } }
          ],
          "items": { "type": "string" }
        },
        "value": { "type": "string", "minLength": 1 }
      }
    }
  }
}
