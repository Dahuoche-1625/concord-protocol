{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concord-protocol.dev/schemas/guarded_upload_task_v0.2",
  "title": "Guarded Upload TaskContract v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id", "task_mode", "project_id", "application_id",
    "required_protocol_version", "required_capabilities", "context_scope",
    "context_expires_at", "input_refs", "redactions",
    "risk_level", "acceptance_criteria", "contract_clarity_score",
    "source_proof",
    "upload_parameters", "validation_gates",
    "approval_grant", "execution_host",
    "idempotency_key", "revocation_check"
  ],
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "task_mode": { "const": "guarded_upload" },
    "project_id": { "type": "string", "minLength": 1 },
    "application_id": { "type": "string", "minLength": 1 },
    "required_protocol_version": { "type": "string", "minLength": 1 },
    "required_capabilities": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string" },
      "contains": { "const": "youtube_api_upload_capable" }
    },
    "context_scope": { "const": "upload_only" },
    "context_expires_at": { "type": "string", "format": "date-time" },
    "input_refs": {
      "type": "array",
      "items": { "type": "string", "pattern": "^(manifest|external)://" }
    },
    "redactions": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string" },
      "contains": { "const": "oauth_token" }
    },
    "risk_level": { "enum": ["low", "medium", "high", "critical"] },
    "acceptance_criteria": {
      "type": "array", "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "contract_clarity_score": { "type": "integer", "minimum": 3, "maximum": 5 },
    "source_proof": { "$ref": "#/$defs/proof" },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "description": "Unique upload key. Runtime must check no prior receipt exists for this key before uploading."
    },
    "execution_host": {
      "type": "string",
      "enum": ["windows_local_powershell", "mac_durable_runner", "task_scheduler"]
    },
    "upload_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_ref", "metadata", "channel_binding", "receipt_config"],
      "properties": {
        "artifact_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "size_bytes", "duration_seconds"],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(manifest|external)://.+"
            },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "size_bytes": { "type": "integer", "minimum": 10485760 },
            "duration_seconds": { "type": "number", "minimum": 1 }
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "description", "privacy_status"],
          "properties": {
            "title": { "type": "string", "minLength": 1, "maxLength": 100 },
            "description": { "type": "string", "minLength": 1, "maxLength": 5000 },
            "tags": {
              "type": "array", "maxItems": 30, "uniqueItems": true,
              "items": { "type": "string", "maxLength": 30 }
            },
            "category_id": { "type": "integer", "minimum": 1, "maximum": 44 },
            "privacy_status": { "enum": ["private", "unlisted", "public"] },
            "thumbnail_path": {
              "type": "string",
              "pattern": "^(manifest|external)://.+"
            },
            "language": { "type": "string", "minLength": 2, "maxLength": 5 }
          }
        },
        "channel_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["channel_key", "expected_channel_id", "token_ref"],
          "properties": {
            "channel_key": { "type": "string", "minLength": 1 },
            "expected_channel_id": {
              "type": "string",
              "pattern": "^UC[A-Za-z0-9_-]{22}$"
            },
            "token_ref": {
              "type": "string",
              "pattern": "^secret://[A-Za-z0-9_-]+$"
            }
          }
        },
        "receipt_config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["receipt_output_dir", "emergency_journal_dir"],
          "properties": {
            "receipt_prefix": { "type": "string" },
            "receipt_output_dir": {
              "type": "string",
              "pattern": "^(manifest|external)://.+"
            },
            "emergency_journal_dir": {
              "type": "string",
              "pattern": "^(manifest|external)://.+"
            }
          }
        }
      }
    },
    "validation_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_owner_approval", "require_expected_channel_id_match",
        "require_token_existence", "require_receipt_on_completion",
        "require_metadata_completeness",
        "block_public_without_explicit_approval", "block_unknown_channel",
        "max_retries", "local_quota_gate_enabled", "daily_upload_limit"
      ],
      "properties": {
        "require_owner_approval": { "const": true },
        "require_expected_channel_id_match": { "const": true },
        "require_token_existence": { "const": true },
        "require_receipt_on_completion": { "const": true },
        "require_metadata_completeness": { "const": true },
        "block_public_without_explicit_approval": { "const": true },
        "block_unknown_channel": { "const": true },
        "max_retries": { "type": "integer", "minimum": 0, "maximum": 3 },
        "local_quota_gate_enabled": { "const": true },
        "daily_upload_limit": { "type": "integer", "minimum": 1 }
      }
    },
    "approval_grant": {
      "$ref": "https://concord-protocol.dev/schemas/approval_grant_v0.1"
    },
    "revocation_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revocation_list_ref", "max_staleness_seconds"],
      "properties": {
        "revocation_list_ref": {
          "type": "string",
          "pattern": "^(manifest|external)://.+",
          "description": "Project-maintained revocation list. Runtime must check before claim."
        },
        "max_staleness_seconds": {
          "type": "integer", "minimum": 60,
          "description": "Maximum age of cached revocation list before re-fetch is required"
        }
      }
    }
  },
  "$defs": {
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "signed_fields", "value"],
      "properties": {
        "method": { "enum": ["hmac", "signature", "hash_chain"] },
        "key_ref": { "type": "string" },
        "signed_fields": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string" }
        },
        "value": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "upload_parameters": {
            "properties": {
              "metadata": {
                "properties": { "privacy_status": { "const": "public" } }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "approval_grant": {
            "properties": { "max_privacy": { "const": "public" } }
          }
        }
      }
    }
  ]
}
