{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-protocol.dev/schemas/review_result.json",
  "title": "ReviewResult",
  "type": "object",
  "additionalProperties": true,
  "required": ["review_id", "task_id", "receipt_id", "reviewer_id", "decision", "rationale", "acceptance_checks", "reviewed_at", "source_refs"],
  "properties": {
    "review_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "receipt_id": { "type": "string", "minLength": 1 },
    "reviewer_id": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["accepted", "rejected", "retry_requested", "escalated"] },
    "rationale": { "type": "string", "minLength": 1 },
    "acceptance_checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterion", "status"],
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "fail", "not_checked"] }
        }
      }
    },
    "next_task_refs": { "type": "array", "items": { "type": "string" } },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
