{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-protocol.dev/schemas/task_lease.json",
  "title": "TaskLease",
  "type": "object",
  "additionalProperties": true,
  "required": ["lease_id", "task_id", "dispatch_id", "status", "source_refs"],
  "properties": {
    "lease_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "dispatch_id": { "type": "string", "minLength": 1 },
    "claimed_by": { "type": ["string", "null"] },
    "node_id": { "type": ["string", "null"] },
    "claimed_at": { "type": ["string", "null"], "format": "date-time" },
    "lease_until": { "type": ["string", "null"], "format": "date-time" },
    "released_at": { "type": ["string", "null"], "format": "date-time" },
    "status": { "enum": ["pending", "active", "expired", "released", "cancelled"] },
    "claim_proof": {
      "type": ["object", "null"],
      "properties": {
        "method": { "enum": ["hmac", "signature", "token", "hash_chain"] },
        "node_id": { "type": "string" },
        "agent_id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "source_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "active" } } },
      "then": {
        "required": ["claimed_by", "node_id", "claimed_at", "lease_until", "claim_proof"],
        "properties": {
          "claimed_by": { "type": "string", "minLength": 1 },
          "node_id": { "type": "string", "minLength": 1 },
          "claimed_at": { "type": "string", "format": "date-time" },
          "lease_until": { "type": "string", "format": "date-time" },
          "claim_proof": { "type": "object" }
        }
      }
    }
  ]
}
